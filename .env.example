# CHORUS Tutorial - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# =============================================================================
# OpenRouter API Configuration
# =============================================================================
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Choose your LLM model (see available models at openrouter.ai/models)
# Free tier options:
#   - google/gemini-2.0-flash-exp:free
#   - google/gemini-1.5-flash:free
# Paid options (better performance):
#   - anthropic/claude-3.5-sonnet
#   - openai/gpt-4-turbo
#   - meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# OpenRouter base URL (usually no need to change)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# =============================================================================
# HuggingFace Configuration (Optional)
# =============================================================================
# Get your token from: https://huggingface.co/settings/tokens
# Required for: certain embedding models, gated models
HF_TOKEN=your_huggingface_token_here

# =============================================================================
# Model Configuration
# =============================================================================

# Embedding model (for vector search)
# Options:
#   - all-MiniLM-L6-v2 (default, lightweight, 384 dim)
#   - nvidia/NV-Embed-v2 (SOTA, large, requires GPU)
#   - Alibaba-NLP/gte-Qwen2-1.5B-instruct
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Cross-encoder model (for reranking)
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# =============================================================================
# Pipeline Configuration
# =============================================================================

# Test mode (True = faster, fewer problems; False = full pipeline)
TEST_MODE=True

# Number of problems to process
NUM_PROBLEMS=2

# LLM temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.0

# Code execution timeout (seconds)
EXECUTION_TIMEOUT=120

# =============================================================================
# Retrieval Configuration
# =============================================================================

# Initial retrieval candidates
RETRIEVAL_TOP_K=10

# Final documentation chunks after reranking
RERANK_TOP_N_DOC=2

# Final code examples after reranking
RERANK_TOP_N_CODE=2

# =============================================================================
# Chunking Configuration
# =============================================================================

# Maximum words per chunk
MAX_CHUNK_WORDS=400

# Number of keywords to generate per problem
NUM_KEYWORDS_MIN=5
NUM_KEYWORDS_MAX=7

# =============================================================================
# API Rate Limiting (Optional)
# =============================================================================

# Delay between API calls (seconds) to avoid rate limits
# API_CALL_DELAY=1

# Maximum retries for failed API calls
# MAX_RETRIES=3

# =============================================================================
# Logging Configuration (Optional)
# =============================================================================

# Verbosity level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# =============================================================================
# Notes
# =============================================================================
# 1. Never commit your actual .env file to Git
# 2. Keep your API keys secure and private
# 3. For free tier OpenRouter, some models have rate limits
# 4. HuggingFace token is optional for most models
# 5. Adjust NUM_PROBLEMS based on available time/credits
