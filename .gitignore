# CHORUS Tutorial - Git Ignore File

# =============================================================================
# Python
# =============================================================================
*.py[cod]
*$py.class
*.so
__pycache__/
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.manifest
*.spec

# =============================================================================
# Jupyter Notebook
# =============================================================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.ipynb_checkpoints

# Jupyter Notebook outputs (optional - uncomment if you want clean notebooks)
# *-checkpoint.ipynb

# =============================================================================
# Environment & Configuration
# =============================================================================
.env
.env.local
.env.*.local
*.env
test.env  # Personal environment file with actual API keys (never push)

# Virtual Environments
venv/
ENV/
env/
.venv
env.bak/
venv.bak/

# Conda
conda-meta/
.conda/

